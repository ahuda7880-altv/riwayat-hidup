  <style>
    :root {
      --navy: #14243a;
      --blue: #2563eb;
      --pale: #eef4ff;
      --ink: #202938;
      --muted: #657184;
      --line: #e3e8ef;
      --white: #ffffff;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      color: var(--ink);
      background: #f7f9fc;
      line-height: 1.65;
    }
    a { color: inherit; text-decoration: none; }
    .container { width: min(1080px, 90%); margin: auto; }
    header {
      background: var(--white);
      position: sticky;
      top: 0;
      z-index: 10;
      border-bottom: 1px solid var(--line);
    }
    nav {
      min-height: 70px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    .brand { font-weight: 800; color: var(--navy); letter-spacing: .4px; }
    .nav-links { display: flex; flex-wrap: wrap; gap: 22px; font-size: 14px; color: var(--muted); }
    .nav-links a:hover { color: var(--blue); }
    .hero {
      padding: 90px 0 82px;
      background: linear-gradient(135deg, #14243a, #203e68);
      color: white;
    }
    .hero-grid { display: grid; grid-template-columns: 1.5fr .8fr; gap: 45px; align-items: center; }
    .eyebrow { color: #a9c7ff; text-transform: uppercase; letter-spacing: 2px; font-size: 12px; font-weight: 700; }
    h1 { font-size: clamp(36px, 6vw, 58px); line-height: 1.12; margin: 14px 0; }
    .hero p { color: #dbe6f7; max-width: 650px; }
    .hero-card {
      border: 1px solid rgba(255,255,255,.22);
      background: rgba(255,255,255,.08);
      padding: 28px;
      border-radius: 18px;
    }
    .hero-card strong { display: block; font-size: 14px; color: #a9c7ff; margin-bottom: 5px; }
    .hero-card span { display: block; margin-bottom: 18px; }
    .hero-card span:last-child { margin-bottom: 0; }
    .button {
      display: inline-block;
      margin-top: 18px;
      background: #fff;
      color: var(--navy);
      padding: 11px 19px;
      border-radius: 8px;
      font-weight: 700;
      font-size: 14px;
    }
    section { padding: 72px 0; }
    section:nth-of-type(even) { background: white; }
    .section-label { color: var(--blue); text-transform: uppercase; letter-spacing: 1.7px; font-size: 12px; font-weight: 800; }
    h2 { color: var(--navy); font-size: 30px; margin: 7px 0 26px; }
    .about { max-width: 780px; color: var(--muted); }
    .skills, .portfolio-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .card {
      background: white;
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 22px;
      box-shadow: 0 8px 24px rgba(20,36,58,.04);
    }
    .skills .card h3, .card h3 { color: var(--navy); margin: 0 0 8px; font-size: 17px; }
    .card p, .card li { color: var(--muted); font-size: 14px; }
    .portfolio-placeholder {
      min-height: 145px;
      display: grid;
      place-items: center;
      text-align: center;
      color: #53709a;
      background: var(--pale);
      border: 1px dashed #a9c3ee;
      border-radius: 10px;
      padding: 16px;
      margin-bottom: 16px;
      font-size: 14px;
    }
    .timeline { border-left: 2px solid #cbdaf3; padding-left: 25px; }
    .timeline-item { position: relative; margin: 0 0 28px; }
    .timeline-item::before {
      content: ""; position: absolute; width: 11px; height: 11px; border-radius: 50%;
      background: var(--blue); left: -32px; top: 7px;
    }
    .timeline-item h3 { margin: 0; color: var(--navy); }
    .timeline-item .meta { color: var(--blue); font-size: 13px; font-weight: 700; }
    .contact-box { background: var(--navy); color: white; padding: 32px; border-radius: 16px; }
    .contact-box h2 { color: white; margin-bottom: 10px; }
    .contact-box p { color: #dbe6f7; }
    footer { text-align: center; padding: 24px; color: var(--muted); font-size: 13px; }
    @media (max-width: 760px) {
      nav { align-items: flex-start; flex-direction: column; padding: 16px 0; }
      .nav-links { gap: 12px; }
      .hero { padding: 65px 0; }
      .hero-grid, .skills, .portfolio-grid { grid-template-columns: 1fr; }
      section { padding: 55px 0; }
    }
  </style>
</head>
